                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Renueva el access token (HU-02). 401 si el refresh token es inválido, expiró o fue revocado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200 con un nuevo access token\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a(\"string\");",
                  "  pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "  // The backend may rotate the refresh token.",
                  "  if (body.refreshToken) {",
                  "    pm.collectionVariables.set(\"refreshToken\", body.refreshToken);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
